# macOS
.DS_Store

# Entornos virtuales
qiskitvenv/
# envs/bugN/: se versiona requirements.txt; el entorno instalado no
envs/*/.venv/
envs/*/.conda/
.venv/
venv/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# LaTeX (archivos auxiliares)
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# Los logs de ejecución de los bugs son evidencia: sí se versionan
!bugs/**/logs/*.log
!bugs/**/static_analysis/*.log

# Herramientas externas clonadas (LintQ, MIT) y bases de datos CodeQL temporales:
# se referencian por URL/commit en docs/static_analysis.md
tools/
work/
